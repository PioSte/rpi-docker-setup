# Example environment variables for Raspberry Pi Docker Setup
# Copy this file to .env and fill in your actual values

# User/Group IDs (get with: id username)
PUID_piotr=1000
PGID_users=100

# DuckDNS Configuration
duckdns_subdomains=your-subdomain
duckdns_token=your-duckdns-token

# Database Configuration
mysql_root_password=your-secure-root-password
mysql_user=nextcloud
mysql_password=your-secure-db-password

# Let's Encrypt/SWAG Configuration
letsencrypt_url=your-domain.duckdns.org
email=your-email@example.com

# Pi-hole Configuration
pihole_webpassword=your-secure-pihole-password

# Monitoring Configuration (new)
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password